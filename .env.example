# Copy to .env and set the endpoint, model ID and key for your provider.
# The model must support OpenAI-compatible Chat Completions tool calling.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-tool-calling-model
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Leave temperature unset for providers/models with restricted sampling parameters.
# LLM_TEMPERATURE=0

# Relative paths are resolved from your working directory.
MCP_CONFIG_PATH=config/mcp.servers.json
MCP_STARTUP_TIMEOUT_SECONDS=30
AGENT_TIMEOUT_SECONDS=120
AGENT_RECURSION_LIMIT=20

# Database: sqlite on this computer; switch to mysql on the destination computer.
DB_ENGINE=sqlite
SQLITE_PATH=data/agent_demo.db
DB_QUERY_TIMEOUT_SECONDS=10
DB_MAX_ROWS=200
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=agent_reader
MYSQL_PASSWORD=
# MYSQL_SSL_CA=C:/certs/mysql-ca.pem

# Search: auto uses Tavily when a key is configured, otherwise DDGS (no key).
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_REGION=wt-wt
WEB_SEARCH_BACKEND=auto
